11. Automated API Tests and Repeatable Test Data

Integration Testing: Verifies that routing, middleware, logic, and response formatting all work together correctly.
Vitest & Supertest: Vitest runs the test suite; Supertest simulates HTTP requests against the Express app without requiring a running port.
Predictable Data: Tests must execute in isolation. If Test A deletes a task and Test B expects it to exist, Test B fails randomly. The shared dataset must be completely reset before each test.

// test/api.test.js
import { describe, it, expect, beforeEach } from 'vitest';
import request from 'supertest';
import app from '../src/app.js';
import { resetTasksForTesting } from '../src/taskManager.js'; // Requires exporting a reset helper

describe('Tasks API', () => {
  beforeEach(() => {
    resetTasksForTesting(); // Reset to the 3 initial tasks before every test
  });

  it('GET /api/tasks returns all tasks', async () => {
    const res = await request(app).get('/api/tasks');
    expect(res.status).toBe(200);
    expect(res.body.length).toBe(3);
  });

  it('POST /api/tasks creates a task', async () => {
    const res = await request(app)
      .post('/api/tasks')
      .send({ title: 'Learn Testing' });
    expect(res.status).toBe(201);
    expect(res.body.title).toBe('Learn Testing');
  });

  it('DELETE /api/tasks/1 removes a task', async () => {
    await request(app).delete('/api/tasks/1').expect(204);
    await request(app).get('/api/tasks/1').expect(404);
  });
});

