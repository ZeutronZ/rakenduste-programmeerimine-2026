6. GET Routes, Route Parameters and Query Parameters

req.params vs. req.query: req.params grabs dynamic parts of the URL path (e.g., /tasks/:id). req.query grabs optional variables after the ? (e.g., ?completed=true).
String Conversion: URL parameters always arrive as strings. An ID must be converted using Number(req.params.id) to match numeric IDs in the array.
"false" is truthy: In JavaScript, any non-empty string evaluates to true. "false" must be explicitly checked (e.g., req.query.completed === 'false').
Valid but missing IDs: If an ID is a valid number but does not exist in the array, the server must return a 404 Not Found.

// src/app.js (continued)
import { getAllTasks, getTaskById } from './taskManager.js';

let tasks = [
  { id: 1, title: "Learn JSX", completed: true },
  { id: 2, title: "Practise React state", completed: false },
  { id: 3, title: "Build a Node.js API", completed: false },
];

app.get('/api/tasks', (req, res) => {
  const { completed } = req.query;
  
  if (completed !== undefined) {
    if (completed !== 'true' && completed !== 'false') {
      return res.status(400).json({ error: "completed query must be 'true' or 'false'" });
    }
    const isCompleted = completed === 'true';
    return res.json(tasks.filter(t => t.completed === isCompleted));
  }
  
  res.json(tasks);
});

app.get('/api/tasks/:id', (req, res) => {
  const id = Number(req.params.id);
  const task = getTaskById(tasks, id);
  
  if (!task) return res.status(404).json({ error: "Task not found" });
  res.json(task);
});

