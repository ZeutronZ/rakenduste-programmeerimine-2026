10. Connecting React to Node.js

Separate Processes: The frontend (port 5173) and backend (port 3000) run independently.
CORS (Cross-Origin Resource Sharing): Browsers block requests between different ports/domains for security. The backend must explicitly allow the frontend's origin using the cors package.
Vite Environment Variables: Variables starting with VITE_ are injected at build time. Deployed frontends cannot use localhost because localhost resolves to the user's personal device, not the backend server.
Rebuilding: Because Vite hardcodes environment variables during the build process, altering VITE_API_URL requires running npm run build again.

// Backend: src/app.js
import cors from 'cors';
// Allow React dev server
app.use(cors({ origin: 'http://localhost:5173' })); 


// Frontend: src/services/taskApi.js
const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:3000/api';

export async function fetchTasks() {
  const response = await fetch(`${API_URL}/tasks`);
  if (!response.ok) throw new Error('Failed to load tasks');
  return response.json();
}

export async function createTask(title) {
  const response = await fetch(`${API_URL}/tasks`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ title }),
  });
  if (!response.ok) throw new Error('Failed to create task');
  return response.json();
}

