15. Testing Saving and Loading with a Temporary File

Avoiding Real Data: Tests must never overwrite or delete tasks.json containing real user data.
Temporary Directories: Sandboxed OS-level folders that isolate test artifacts and can be safely deleted.
Cleanup (finally): Ensures the fs.rm cleanup command executes even if an expect assertion fails halfway through the test, preventing hard drive bloat.

// test/storage.test.js
import { describe, it, expect } from 'vitest';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import { saveTasks, loadTasks } from '../src/storage.js';

describe('Storage', () => {
  it('saves and loads tasks using a temporary directory', async () => {
    let tempDir;
    
    try {
      // 1. Create unique temp directory
      tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'task-test-'));
      const testFilePath = path.join(tempDir, 'tasks.json');
      
      const sampleTasks = [
        { id: 1, title: "Test task 1", completed: false },
        { id: 2, title: "Test task 2", completed: true }
      ];

      // 2. Save tasks
      await saveTasks(testFilePath, sampleTasks);
      
      // 3. Load tasks
      const loadedTasks = await loadTasks(testFilePath);

      // 4. Assert matches
      expect(loadedTasks).toEqual(sampleTasks);
      
    } finally {
      // 5. Cleanup even if assertions fail
      if (tempDir) {
        await fs.rm(tempDir, { recursive: true, force: true });
      }
    }
  });
});
