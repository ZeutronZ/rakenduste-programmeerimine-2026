5. Events, useState, and Conditional Rendering

// src/TaskCard.jsx
import { useState } from 'react';

export function TaskCard({ title, initialCompleted }) {
  const [completed, setCompleted] = useState(initialCompleted);

  const handleToggle = () => {
    setCompleted((prevStatus) => !prevStatus);
  };

  return (
    <div className="task-card">
      <h3>{title}</h3>
      <p>Status: {completed ? 'Completed' : 'Not completed'}</p>
      <button onClick={handleToggle}>
        Mark as {completed ? 'Incomplete' : 'Completed'}
      </button>
    </div>
  );
}


6. Lists, Keys, and Filtering

// src/TaskList.jsx
import { useState } from 'react';

const initialTasks = [
  { id: 1, title: 'Learn JSX', completed: true },
  { id: 2, title: 'Practise React state', completed: false },
  { id: 3, title: 'Build a Node.js API', completed: false },
];

export function TaskList() {
  const [tasks] = useState(initialTasks);
  const [filter, setFilter] = useState('all');

  // Derived state calculated during component execution
  const filteredTasks = tasks.filter((task) => {
    if (filter === 'completed') return task.completed;
    if (filter === 'incomplete') return !task.completed;
    return true;
  });

  return (
    <div>
      <div>
        <button onClick={() => setFilter('all')}>All</button>
        <button onClick={() => setFilter('completed')}>Completed</button>
        <button onClick={() => setFilter('incomplete')}>Incomplete</button>
      </div>

      {filteredTasks.length === 0 ? (
        <p>No tasks found</p>
      ) : (
        <ul>
          {filteredTasks.map((task) => (
            <li key={task.id}>
              {task.title} - {task.completed ? 'Completed' : 'Incomplete'}
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}


7. Controlled Forms and Validation

// src/TaskForm.jsx
import { useState } from 'react';

export function TaskForm({ onAddTask }) {
  const [title, setTitle] = useState('');
  const [error, setError] = useState('');

  const handleSubmit = (e) => {
    e.preventDefault();
    const trimmedTitle = title.trim();

    if (!trimmedTitle) {
      setError('Task title cannot be empty.');
      return;
    }

    onAddTask(trimmedTitle);
    setTitle('');
    setError('');
  };

  return (
    <form onSubmit={handleSubmit}>
      <label htmlFor="task-title">Task Title:</label>
      <input
        id="task-title"
        type="text"
        value={title}
        onChange={(e) => setTitle(e.target.value)}
      />
      <button type="submit">Add Task</button>
      {error && <p style={{ color: 'red' }}>{error}</p>}
    </form>
  );
}


8. Shared State and Adding, Updating, and Deleting Tasks

// src/App.jsx
import { useState } from 'react';
import { TaskForm } from './TaskForm';

const initialTasks = [
  { id: 1, title: 'Learn JSX', completed: true },
  { id: 2, title: 'Practise React state', completed: false },
  { id: 3, title: 'Build a Node.js API', completed: false },
];

export default function App() {
  const [tasks, setTasks] = useState(initialTasks);

  const handleAddTask = (title) => {
    const newTask = {
      id: Date.now(),
      title,
      completed: false,
    };
    setTasks((prevTasks) => [...prevTasks, newTask]);
  };

  const handleToggleTask = (id) => {
    setTasks((prevTasks) =>
      prevTasks.map((task) =>
        task.id === id ? { ...task, completed: !task.completed } : task
      )
    );
  };

  const handleDeleteTask = (id) => {
    setTasks((prevTasks) => prevTasks.filter((task) => task.id !== id));
  };

  return (
    <div>
      <TaskForm onAddTask={handleAddTask} />
      <ul>
        {tasks.map((task) => (
          <li key={task.id}>
            <span style={{ textDecoration: task.completed ? 'line-through' : 'none' }}>
              {task.title}
            </span>
            <button onClick={() => handleToggleTask(task.id)}>Toggle</button>
            <button onClick={() => handleDeleteTask(task.id)}>Delete</button>
          </li>
        ))}
      </ul>
    </div>
  );
}


9. React Router and Task Details

npm install react-router-dom

// src/App.jsx
import { HashRouter, Routes, Route, Link, useParams } from 'react-router-dom';

const tasks = [
  { id: 1, title: "Learn JSX", completed: true },
  { id: 2, title: "Practise React state", completed: false },
  { id: 3, title: "Build a Node.js API", completed: false },
];

function TaskDetail() {
  const { taskId } = useParams();
  const task = tasks.find((t) => t.id === Number(taskId));

  if (!task) return <h2>Task not found.</h2>;

  return (
    <div>
      <h2>Task Details</h2>
      <p><strong>Title:</strong> {task.title}</p>
      <p><strong>Status:</strong> {task.completed ? 'Completed' : 'Incomplete'}</p>
      <Link to="/tasks">Back to List</Link>
    </div>
  );
}

export default function App() {
  return (
    <HashRouter>
      <nav>
        <Link to="/">Home</Link> | <Link to="/tasks">Tasks</Link>
      </nav>
      <Routes>
        <Route path="/" element={<h2>Home Page</h2>} />
        <Route
          path="/tasks"
          element={
            <ul>
              {tasks.map((task) => (
                <li key={task.id}>
                  <Link to={`/tasks/${task.id}`}>{task.title}</Link>
                </li>
              ))}
            </ul>
          }
        />
        <Route path="/tasks/:taskId" element={<TaskDetail />} />
        <Route path="*" element={<h2>404 Page Not Found</h2>} />
      </Routes>
    </HashRouter>
  );
}


