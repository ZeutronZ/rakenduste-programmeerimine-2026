// src/TaskCard.test.jsx
import { render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { describe, it, expect, vi } from 'vitest';
import { TaskCard } from './TaskCard';

describe('TaskCard Component', () => {
  const sampleTask = {
    id: 1,
    title: 'Learn JSX',
    completed: true,
  };

  it('renders the task title correctly', () => {
    render(<TaskCard task={sampleTask} onToggle={() => {}} />);
    
    // Asserts that the title text exists in the document
    expect(screen.getByText('Learn JSX')).toBeInTheDocument();
  });

  it('calls onToggle with task ID when toggle button is clicked', async () => {
    const handleToggleMock = vi.fn();
    const user = userEvent.setup();

    render(<TaskCard task={sampleTask} onToggle={handleToggleMock} />);

    // Query button by its accessible role and text
    const button = screen.getByRole('button', { name: /toggle status/i });
    
    // Simulate user click
    await user.click(button);

    // Verify mock callback invocation and parameters
    expect(handleToggleMock).toHaveBeenCalledTimes(1);
    expect(handleToggleMock).toHaveBeenCalledWith(1);
  });
});

