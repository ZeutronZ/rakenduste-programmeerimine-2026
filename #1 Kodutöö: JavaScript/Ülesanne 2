5. Comparisons, Logical Operators, and Decisions

// Comparisons
console.log(10 > 5);  // true
console.log(10 <= 5); // false

// === (strict equality) vs == (loose equality)
// ALWAYS prefer === because it checks both value AND type.
console.log(5 == "5");  // true (type coercion applied)
console.log(5 === "5"); // false (different types)
console.log(5 !== "5"); // true (strictly not equal)

// Logical Operators
const isLoggedIn = true;
const isAdmin = false;

console.log(isLoggedIn && isAdmin); // false (AND: both must be true)
console.log(isLoggedIn || isAdmin); // true (OR: at least one must be true)
console.log(!isLoggedIn);           // false (NOT: flips the boolean)

// Truthy and Falsy values
// Falsy: false, 0, "", null, undefined, NaN
// Truthy: Everything else (e.g., "hello", 1, [], {})
if ("") {
  console.log("This won't run because empty strings are falsy.");
}

// Decisions: if, else if, else
const userAge = 20;

if (userAge < 13) {
  console.log("Child account");
} else if (userAge >= 13 && userAge < 18) {
  console.log("Teen account");
} else {
  console.log("Adult account");
}

// Ternary Operator: condition ? true_value : false_value
const statusMessage = isLoggedIn ? "Welcome!" : "Please log in.";
console.log(statusMessage); // "Welcome!"

6. Numbers and the Math Object

// Rounding
console.log(Math.round(4.5)); // 5 (Rounds to nearest)
console.log(Math.floor(4.9)); // 4 (Rounds down)
console.log(Math.ceil(4.1));  // 5 (Rounds up)

// Min and Max
console.log(Math.min(10, 5, 20)); // 5
console.log(Math.max(10, 5, 20)); // 20

// Math.random() returns a decimal between 0 (inclusive) and 1 (exclusive)
const rand = Math.random(); 

// Example: Random whole number from 1 to 6 (like rolling a die)
const min = 1;
const max = 6;
// Math.random() * 6 gives a range of 0 to 5.999...
// Math.floor() rounds it down to 0, 1, 2, 3, 4, or 5.
// Adding min (1) shifts the range to 1, 2, 3, 4, 5, or 6.
const dieRoll = Math.floor(Math.random() * (max - min + 1)) + min;
console.log(`You rolled a ${dieRoll}!`);

7. Arrays and Loops

// Creating and accessing (0-based indexing)
const names = ["Alice", "Bob", "Charlie"];
console.log(names[0]); // "Alice"
console.log(names.length); // 3

// Methods that don't change the original array
console.log(names.includes("Bob")); // true

// Methods that DO change (mutate) the original array
names.push("Dave"); // Adds to the end
const removed = names.pop(); // Removes and returns the last item ("Dave")

// 1. Traditional 'for' loop
// Structure: (counter setup; run condition; update counter)
for (let i = 0; i < names.length; i++) {
  console.log(`Hello, ${names[i]}`);
}

// 2. 'for...of' loop (simpler, usually preferred for arrays)
for (const name of names) {
  if (name === "Bob") {
    console.log("Found Bob, stopping loop!");
    break; // Exits the loop entirely immediately
  }
  console.log(`Checking ${name}...`);
}

// Avoiding infinite loops: 
// Ensure your condition (e.g., i < 10) will eventually evaluate to false,
// usually by incrementing a counter (i++).

8. Objects and Handling Missing Data

// Creating an object
const user = {
  id: 101,
  name: "Eve",
  address: {
    city: "New York"
  }
};

// Reading properties
console.log(user.name); 
console.log(user["id"]); 

// Adding/Updating
user.email = "eve@example.com";
user.name = "Eve Smith";

// Accessing missing properties returns 'undefined'
console.log(user.phone); // undefined

// Optional Chaining (?.)
console.log(user.settings?.theme); // undefined (No error thrown)

// Nullish Coalescing (??) vs Logical OR (||)
const userScore = 0; 
// || sees 0 as falsy and uses the fallback.
console.log(userScore || 10); // 10 (Incorrect if score is actually 0!)
// ?? sees 0 as a valid value and keeps it.
console.log(userScore ?? 10); // 0 (Correct!)
// Example: Profile with missing info
const bio = user.bio ?? "This user hasn't written a bio yet.";
console.log(bio);

