14. Asynchronous JavaScript: Promises and async/await

// Why finish later? Network requests, timers, or file reading take time.
// JavaScript shouldn't "freeze" while waiting.

// A Promise represents the eventual completion (or failure) of an async operation.
// States: 
// 1. Pending (working)
// 2. Fulfilled (success)
// 3. Rejected (failed)

// A function returning a mock promise
function getWeather() {
  return new Promise((resolve) => {
    setTimeout(() => resolve("Sunny, 72°F"), 1000);
  });
}

// async/await makes async code look synchronous and readable.
async function displayWeather() {
  console.log("Fetching weather...");
  
  // 'await' pauses the execution of this specific function until the promise fulfills
  const weather = await getWeather(); 
  
  console.log(`Today's weather: ${weather}`);
}

displayWeather();

15. Fetching Data, JSON, and Error Handling

async function fetchUserData(userId) {
  try {
    // 1. Request data with fetch()
    const response = await fetch(`https://jsonplaceholder.typicode.com/users/${userId}`);
    
    // HTTP errors (like 404 Not Found) do NOT throw a standard try/catch error in fetch().
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status}`);
    }

    // 2. Parse the JSON
    // JSON is just a text string format. await response.json() converts that text 
    // string into an actual usable JavaScript object/array.
    const user = await response.json();
    
    console.log("User data retrieved:", user.name);
    return user;

  } catch (error) {
    // 3. Handle errors gracefully (network failures, or our thrown HTTP error)
    console.error("Failed to fetch user:", error.message);
  }
}
fetchUserData(1);   
fetchUserData(999); 

