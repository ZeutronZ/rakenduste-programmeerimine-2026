11. Array Methods: map, filter, and find

const products = [
  { id: 1, name: "Laptop", price: 1000 },
  { id: 2, name: "Mouse", price: 25 },
  { id: 3, name: "Keyboard", price: 75 }
];

// .map(): Returns a NEW array by transforming every item.
const productNames = products.map(product => product.name);
console.log(productNames); // ["Laptop", "Mouse", "Keyboard"]

// .filter(): Returns a NEW array containing only items that match the condition.
const cheapProducts = products.filter(product => product.price < 50);
console.log(cheapProducts);

// .find(): Returns the FIRST matching item itself.
const mouse = products.find(product => product.name === "Mouse");
console.log(mouse); // { id: 2, name: "Mouse", price: 25 }

12. Destructuring and Spread Syntax

// Array Destructuring: Extract values by position
const rgb = [255, 128, 0];
const [red, green, blue] = rgb;
console.log(green); // 128

// Object Destructuring: Extract values by property name
const config = { host: "localhost", port: 8080 };
const { host, port } = config;
console.log(host); // "localhost"

// Spread Syntax (...) for Arrays
const oldArray = [1, 2];
const newArray = [...oldArray, 3]; // Copies oldArray, adds 3
console.log(newArray); // [1, 2, 3]

// Spread Syntax (...) for Objects
const originalUser = { name: "Alice", age: 25 };
// Copies originalUser, updates age
const updatedUser = { ...originalUser, age: 26 }; 

// Why can we modify a const object?
// 'const' prevents reassignment of the variable itself, but the properties 
// inside the object/array are still mutable.
const myData = { count: 1 };
myData.count = 2; // Allowed
// myData = { count: 3 }; // Error!

